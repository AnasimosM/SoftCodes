#!/usr/bin/env python3
"""
prepare-commit-msg hook sample

Place this file in your repository's .git/hooks/prepare-commit-msg (or copy it there)
and ensure it's executable. On Windows with Git for Windows, hooks are usually
run using the bundled bash; using a python script is generally OK if python
is available.

This hook uses the auto_commit_message.py script (assumed to live in the
repository root) to populate an initial commit message when none is present.

Git passes the path to the commit message file as the first positional arg.
If the commit message already exists (e.g. user passed -m), the hook leaves it.
"""
import os
import subprocess
import sys


def find_repo_root() -> str:
    try:
        out = subprocess.check_output(["git", "rev-parse", "--show-toplevel"])  # type: ignore
        return out.decode("utf-8").strip()
    except Exception:
        return os.getcwd()


def main(argv):
    if len(argv) < 2:
        print('prepare-commit-msg hook expects at least one argument: <commit-msg-file>')
        return 1

    commit_msg_file = argv[1]

    # If there is already content in the commit message file (e.g. -m was used), skip
    try:
        with open(commit_msg_file, 'r', encoding='utf-8') as fh:
            content = fh.read().strip()
            if content:
                return 0
    except FileNotFoundError:
        pass

    repo_root = find_repo_root()
    script_path = os.path.join(repo_root, 'auto_commit_message.py')
    if not os.path.exists(script_path):
        # nothing we can do
        return 0

    # run the generator and write to the commit-msg file
    try:
        subprocess.check_call([sys.executable, script_path, '--write', commit_msg_file])
    except subprocess.CalledProcessError:
        # non-critical: leave empty file
        return 0

    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv))
